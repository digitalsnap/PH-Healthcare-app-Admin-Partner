# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and publishable (anon) key. Safe in the browser:
# row-level security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role (secret) key. Server only: it bypasses row-level security.
# Never prefix it with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Tests only: a LOCAL Postgres with PostGIS for the database tests (see
# README.md). The test helper refuses any non-local host.
TEST_DATABASE_URL=
